{
  "$schema": "https://allmonty.github.io/gamebook-framework/schema/story.schema.json",
  "schema": 1,
  "id": "ash-road",
  "lang": "pt",
  "title": "A Estrada das Cinzas",
  "author": "Você",
  "description": "Uma aventura com tabela de resultados: artes escolhidas no começo, mochila de oito espaços, refeições e lutas lidas numa tabela.",
  "rules": {
    "health": "endurance",
    "rerolls": 1,
    "stats": {
      "prowess": {
        "label": "Destreza",
        "roll": "1d10+9"
      },
      "endurance": {
        "label": "Resistência",
        "roll": "1d10+19",
        "max": true
      },
      "gold": {
        "label": "Ouro",
        "roll": "1d10",
        "limit": 50
      }
    },
    "combat": {
      "mode": "table",
      "attackStat": "prowess",
      "roll": "1d10-1",
      "table": [
        {
          "upTo": -3,
          "results": [
            [
              0,
              4
            ],
            [
              0,
              3
            ],
            [
              1,
              3
            ],
            [
              1,
