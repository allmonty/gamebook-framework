            ],
            [
              4,
              0
            ]
          ]
        },
        {
          "upTo": 3,
          "results": [
            [
              1,
              2
            ],
            [
              2,
              2
            ],
            [
              2,
              1
            ],
            [
              3,
              1
            ],
            [
              3,
              1
            ],
            [
              4,
              1
            ],
            [
              4,
              0
            ],
            [
              5,
              0
            ],
            [
              5,
              0
            ],
            [
              6,
              0
            ]
          ]
        },
        {
          "results": [
            [
              3,
              1
            ],
            [
              4,
              1
            ],
            [
              5,
              0
            ],
            [
              5,
