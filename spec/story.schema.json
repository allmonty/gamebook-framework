{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.schema.json",
  "title": "Gamebook story, schema version 1",
  "description": "Shape only. Cross-references (targets, items, stats) are checked by a validator such as the Dart engine's validate_story. Spec: spec/framework.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "lang",
    "title",
    "rules",
    "start",
    "nodes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "description": "The version of the format; 1 is the only one so far",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "lang": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "coverAlt": {
      "description": "What the cover shows, for players who cannot see it",
      "type": "string",
      "pattern": "\\S"
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/item"
      }
    },
    "journal": {
      "description": "Notes the player unlocks with the { \"journal\": id } effect.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "achievements": {
      "description": "Things a player can earn, kept across games, by id",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "chapters": {
      "description": "Groups of pages, in reading order, by id; for authors and editors",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          }
        }
      }
    },
    "showTitles": {
      "description": "Show node titles to players as page headings",
      "type": "boolean"
    },
    "start": {
      "$ref": "#/$defs/id"
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "dice": {
      "description": "NdM, NdM+K, NdM-K or a plain integer; at most 100 dice, 1000 faces and 6 digits for K or the integer",
      "type": "string",
      "pattern": "^([0-9]{1,3}d[0-9]{1,4}([+-][0-9]{1,6})?|[0-9]{1,6})$"
    },
    "operand": {
      "description": "An integer, or the id of a stat",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "fighting-fantasy",
            "d20-lite"
          ]
        },
        "rerolls": {
          "type": "integer",
          "minimum": 0
        },
        "health": {
          "$ref": "#/$defs/id"
        },
        "stats": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "roll": {
                "$ref": "#/$defs/dice"
              },
              "max": {
                "type": "boolean"
              },
              "limit": {
                "description": "A ceiling that does not depend on the roll (not with max: true)",
                "type": "integer",
                "minimum": 1
              },
              "min": {
                "description": "The floor, which may be negative (default 0); not on the health stat",
                "type": "integer"
              },
              "hidden": {
                "description": "Kept off the stats bar",
                "type": "boolean"
              }
            }
          }
        },
        "combat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "opposed",
                "vs-defense",
                "table"
              ]
            },
            "attackRoll": {
              "$ref": "#/$defs/dice"
            },
            "attackStat": {
              "$ref": "#/$defs/id"
            },
            "defenseStat": {
              "$ref": "#/$defs/id"
            },
            "defenseBase": {
              "type": "integer"
            },
            "damage": {
              "$ref": "#/$defs/dice"
            },
            "roll": {
              "description": "Table mode. Must be able to give 0 (default 1d10-1)",
              "$ref": "#/$defs/dice"
            },
            "table": {
              "description": "Table mode. Rows by combat ratio; the last row has no upTo.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "results"
                ],
                "properties": {
                  "upTo": {
                    "type": "integer"
                  },
                  "results": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            },
            "luck": {
              "description": "Testing your Luck in a fight",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stat"
              ],
              "properties": {
                "stat": {
                  "$ref": "#/$defs/id"
                },
                "roll": {
                  "$ref": "#/$defs/dice"
                },
                "lucky": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "dealt": {
                      "type": "integer"
                    },
                    "taken": {
                      "type": "integer"
                    }
                  }
                },
                "unlucky": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "dealt": {
                      "type": "integer"
                    },
                    "taken": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capacity": {
              "type": "integer",
              "minimum": 1
            },
            "pickup": {
              "enum": [
                "auto",
                "choose"
              ]
            }
          }
        },
        "undo": {
          "description": "How many pages the player can go back (default 0)",
          "type": "integer",
          "minimum": 0
        },
        "creation": {
          "description": "The hero's name and groups of options to pick from at the start",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "boolean"
            },
            "picks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "count",
                  "options"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "title": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "$ref": "#/$defs/id"
                        },
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "effects": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/effect"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bonuses": {
          "description": "Bonuses to stats while a condition holds",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "if",
              "bonus"
            ],
            "properties": {
              "if": {
                "$ref": "#/$defs/condition"
              },
              "bonus": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/id"
                },
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "everyPage": {
          "description": "Effects applied on entering every page, before its own",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effects"
            ],
            "properties": {
              "if": {
                "$ref": "#/$defs/condition"
              },
              "effects": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/effect"
                }
              },
              "calm": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "description": "What the image shows, for players who cannot see it",
          "type": "string",
          "pattern": "\\S"
        },
        "use": {
          "$ref": "#/$defs/itemUse"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "stack": {
          "description": "How many fit in one pack slot; makes the item countable",
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "description": "The most of a countable item the player can hold",
          "type": "integer",
          "minimum": 1
        },
        "bonus": {
          "description": "Added to these stats while the item is carried",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "dependentRequired": {
        "imageAlt": [
          "image"
        ],
        "max": [
          "stack"
        ]
      },
      "not": {
        "description": "A container cannot be counted",
        "required": [
          "capacity",
          "stack"
        ]
      }
    },
    "condition": {
      "description": "Exactly one kind per object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "has"
          ],
          "properties": {
            "has": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "description": "How many of a countable item (one with a stack)",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flag"
          ],
          "properties": {
            "flag": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visited"
          ],
          "properties": {
            "visited": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stat"
          ],
          "properties": {
            "stat": {
              "$ref": "#/$defs/id"
            },
            "gte": {
              "$ref": "#/$defs/quantity"
            },
            "lte": {
              "$ref": "#/$defs/quantity"
            },
            "eq": {
              "$ref": "#/$defs/quantity"
            }
          },
          "oneOf": [
            {
              "required": [
                "gte"
              ]
            },
            {
              "required": [
                "lte"
              ]
            },
            {
              "required": [
                "eq"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visits"
          ],
          "properties": {
            "visits": {
              "$ref": "#/$defs/id"
            },
            "gte": {
              "type": "integer"
            },
            "lte": {
              "type": "integer"
            },
            "eq": {
              "type": "integer"
            }
          },
          "oneOf": [
            {
              "required": [
                "gte"
              ]
            },
            {
              "required": [
                "lte"
              ]
            },
            {
              "required": [
                "eq"
              ]
            }
          ]
        }
      ]
    },
    "effect": {
      "description": "Exactly one kind per object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "give"
          ],
          "properties": {
            "give": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "description": "How many of a countable item (one with a stack)",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "take"
          ],
          "properties": {
            "take": {
              "$ref": "#/$defs/id"
            },
            "count": {
              "description": "How many of a countable item (one with a stack)",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set"
          ],
          "properties": {
            "set": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clear"
          ],
          "properties": {
            "clear": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stat"
          ],
          "properties": {
            "stat": {
              "$ref": "#/$defs/id"
            },
            "add": {
              "$ref": "#/$defs/quantity"
            },
            "set": {
              "$ref": "#/$defs/quantity"
            }
          },
          "oneOf": [
            {
              "required": [
                "add"
              ]
            },
            {
              "required": [
                "set"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "takeAll"
          ],
          "properties": {
            "takeAll": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "journal"
          ],
          "properties": {
            "journal": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "description": "Earns an achievement",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "achieve"
          ],
          "properties": {
            "achieve": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roll",
        "op",
        "vs",
        "pass",
        "fail"
      ],
      "properties": {
        "roll": {
          "$ref": "#/$defs/dice"
        },
        "add": {
          "$ref": "#/$defs/operand"
        },
        "op": {
          "enum": [
            "gte",
            "lte"
          ]
        },
        "vs": {
          "$ref": "#/$defs/operand"
        },
        "pass": {
          "$ref": "#/$defs/id"
        },
        "fail": {
          "$ref": "#/$defs/id"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "check": {
          "$ref": "#/$defs/check"
        },
        "if": {
          "$ref": "#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "hideIfLocked": {
          "type": "boolean"
        },
        "lockedText": {
          "type": "string"
        },
        "once": {
          "type": "boolean"
        },
        "table": {
          "$ref": "#/$defs/randomTable"
        },
        "call": {
          "description": "Remember this page for a later return",
          "type": "boolean"
        },
        "return": {
          "description": "Lead back to the page last remembered, instead of to",
          "const": true
        }
      },
      "oneOf": [
        {
          "required": [
            "to"
          ]
        },
        {
          "required": [
            "check"
          ]
        },
        {
          "required": [
            "table"
          ]
        },
        {
          "required": [
            "return"
          ]
        }
      ],
      "not": {
        "description": "A choice cannot both call and return",
        "required": [
          "call",
          "return"
        ]
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "attack",
        "health"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "attack": {
          "type": "integer"
        },
        "health": {
          "type": "integer",
          "minimum": 1
        },
        "defense": {
          "type": "integer"
        },
        "damage": {
          "$ref": "#/$defs/dice"
        },
        "armor": {
          "description": "Taken off every wound the player deals this enemy",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enemies",
        "win"
      ],
      "properties": {
        "enemies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enemy"
          }
        },
        "win": {
          "$ref": "#/$defs/target"
        },
        "flee": {
          "$ref": "#/$defs/target"
        },
        "fleeCost": {
          "description": "\"round\": fleeing lets the enemies strike first",
          "enum": [
            "round",
            "free"
          ]
        },
        "wounded": {
          "description": "Where the fight goes the first time the player is wounded and still alive",
          "$ref": "#/$defs/id"
        },
        "rounds": {
          "description": "Where the fight goes once `after` rounds are played and it is not over",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "after",
            "to"
          ],
          "properties": {
            "after": {
              "type": "integer",
              "minimum": 1
            },
            "to": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "simultaneous": {
          "description": "All enemies fight at once; the player picks a target each round",
          "type": "boolean"
        },
        "duel": {
          "description": "Resolved by rules.combat.table instead of the combat mode",
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "fleeCost": [
          "flee"
        ]
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "A string, or a list of parts. {stat} and {stat.max} are replaced by values ({item.count} by how many of the item are held); {{ and }} are literal braces.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/textPart"
              }
            }
          ]
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "description": "What the image shows, for players who cannot see it",
          "type": "string",
          "pattern": "\\S"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "once": {
          "type": "boolean"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "combat": {
          "$ref": "#/$defs/combat"
        },
        "ending": {
          "enum": [
            "victory",
            "defeat",
            "death"
          ]
        },
        "music": {
          "description": "A file that loops from this page on, or \"stop\"",
          "type": "string"
        },
        "sound": {
          "description": "A file played once when the page is entered",
          "type": "string"
        },
        "title": {
          "description": "A short name for the page; players see it only with showTitles",
          "type": "string",
          "pattern": "\\S"
        },
        "note": {
          "description": "For authors only, never shown to players",
          "type": "string"
        },
        "chapter": {
          "description": "A key of the story's chapters",
          "$ref": "#/$defs/id"
        },
        "draft": {
          "description": "Not written yet: text and a way out may be missing",
          "type": "boolean"
        }
      },
      "if": {
        "required": [
          "draft"
        ],
        "properties": {
          "draft": {
            "const": true
          }
        }
      },
      "else": {
        "required": [
          "text"
        ],
        "oneOf": [
          {
            "required": [
              "choices"
            ]
          },
          {
            "required": [
              "combat"
            ]
          },
          {
            "required": [
              "ending"
            ]
          }
        ]
      },
      "dependentRequired": {
        "imageAlt": [
          "image"
        ]
      }
    },
    "itemUse": {
      "description": "combatCost only with combat in when.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effects",
        "when"
      ],
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "story",
              "combat"
            ]
          }
        },
        "combatCost": {
          "enum": [
            "round",
            "free"
          ]
        }
      }
    },
    "textPart": {
      "description": "A string, or a part shown only while its condition holds ",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "if": {
              "$ref": "#/$defs/condition"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "randomTable": {
      "description": "UpTo must increase and the last must cover the largest roll (checked by the parser).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roll",
        "outcomes"
      ],
      "properties": {
        "roll": {
          "$ref": "#/$defs/dice"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "upTo",
              "to"
            ],
            "properties": {
              "upTo": {
                "type": "integer"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "effects": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/effect"
                }
              }
            }
          }
        }
      }
    },
    "quantity": {
      "description": "An integer, or the value of a stat times `times` (default 1)",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stat"
          ],
          "properties": {
            "stat": {
              "$ref": "#/$defs/id"
            },
            "times": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "target": {
      "description": "A node id, or back to the page last remembered",
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "return"
          ],
          "properties": {
            "return": {
              "const": true
            }
          }
        }
      ]
    }
  },
  "dependentRequired": {
    "coverAlt": [
      "cover"
    ]
  }
}
