{
  "schema": 1,
  "id": "journal-clues",
  "lang": "en",
  "title": "The Study",
  "rules": {
    "preset": "fighting-fantasy"
  },
  "journal": {
    "letter": {
      "title": "The wizard's letter",
      "text": "\"The vault answers to the word EMBER.\""
    },
    "map": {
      "title": "The wall map",
      "text": "A tunnel runs from the cellar to the river."
    }
  },
  "achievements": {
    "scholar": {
      "title": "Scholar",
      "description": "Finished the study."
    },
    "cartographer": {
