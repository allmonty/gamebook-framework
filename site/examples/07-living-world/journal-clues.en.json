      "hidden": true
    }
  },
  "start": "study",
  "nodes": {
    "study": {
      "text": "A dead wizard's study. A letter on the desk, a map on the wall.",
      "choices": [
        {
          "text": "Read the letter",
          "to": "study",
          "once": true,
          "effects": [
            {
              "journal": "letter"
            }
          ]
        },
        {
          "text": "Study the map",
          "to": "study",
          "once": true,
          "effects": [
            {
              "journal": "map"
            },
            {
              "achieve": "cartographer"
            }
          ]
        },
        {
          "text": "Leave with what you learned",
          "to": "end"
        }
      ]
    },
    "end": {
      "text": "You leave. Open the journal under your pack to reread your clues.",
      "effects": [
        {
          "achieve": "scholar"
        }
      ],
      "ending": "victory"
    }
  }
